<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarCreate"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1967D2"
        app:title="EduTrack — Create Content"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@android:drawable/ic_menu_revert" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Content Type Selector (Subject, Lesson, Quiz, Project) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Content Type"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#5F6368"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerContentType"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="16dp" />

            <!-- Title Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Title / Subject Name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#5F6368"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etContentTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input"
                android:hint="e.g., General Physics or Quiz #1"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!-- Description / Instructions Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instructions / Details"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#5F6368"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etContentDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="Provide instructions, guidelines, or details..."
                android:padding="16dp"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!-- Due Date Selector Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Due Date"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#5F6368"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnSelectDueDate"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="@android:color/white"
                android:text="📅 Select Due Date: None"
                android:textColor="#202124"
                style="?attr/materialButtonOutlinedStyle"
                app:strokeColor="#DADCE0"
                app:cornerRadius="8dp"
                android:layout_marginBottom="24dp" />

            <!-- Publish Button -->
            <Button
                android:id="@+id/btnPublishContent"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#1967D2"
                android:text="Post to EduTrack"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>